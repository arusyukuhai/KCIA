oo);\n}\n\nfn main() {\n    // Calling the method is still fine, as i32 implements Debug.\n    some_func(5i32);\n\n    // This would fail to compile now:\n    // struct WithoutDebug;\n    // some_func(WithoutDebug);\n}\n```\n\nRust only looks at the signature of the called function, as such it must\nalready specify all requirements that will be used for every type parameter.\n"},"level":"error","spans":[{"file_name":"/Users/al/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/egg-0.9.5/src/macros.rs","byte_start":6289,"byte_end":6294,"line_start":167,"line_end":167,"column_start":43,"column_end":48,"is_primary":true,"text":[{"text":"            { $($decl)*          $variant($data), }","highlight_start":43,"highlight_end":48}],"label":"the trait `Hash` is not implemented for `f64`","suggested_replacement":null,"suggestion_applicability":null,"expansion":{"span":{"file_name":"/Users/al/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/egg-0.9.5/src/macros.rs","byte_start":2613,"byte_end":2617,"line_start":78,"line_end":78,"column_start":57,"column_end":61,"is_primary":false,"text":[{"text":"        #[derive(Debug, PartialEq, Eq, PartialOrd, Ord, Hash, Clone)]","highlight_start":57,"highlight_end":61}],"label":null,"suggested_replacement":null,"suggestion_applicability":null,"expansion":{"span":{"file_name":"/Users/al/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/egg-0.9.5/src/macros.rs","byte_start":4948,"byte_end":5855,"line_start":140,"line_end":153,"column_start":9,"column_end":10,"is_primary":false,"text":[{"text":"        $crate::__define_language!(","highlight_start":9,"highlight_end":36},{"text":"            $(#[$meta])* $vis enum $name","highlight_start":1,"highlight_end":41},{"text":"            { $($variants)* } ->","highlight_start":1,"highlight_end":33},{"text":"            { $($decl)*          $variant($ids), }","highlight_start":1,"highlight_end":51},{"text":"            { $($matches)*       ($name::$variant(l), $name::$variant(r)) => $crate