# Generate with: python3 deploy/vps/setup_env.py --signal-host signal.example.com --turn-host turn.example.com --public-ip VPS_IPV4
# Then paste the secret token from Cloudflare Tunnel dashboard into CF_TUNNEL_TOKEN.
SIGNAL_HOST=signal.example.com
TURN_HOST=turn.example.com
TURN_REALM=turn.example.com
PUBLIC_IP=203.0.113.10
CF_TUNNEL_TOKEN=PASTE_CLOUDFLARE_TUNNEL_TOKEN_HERE
TURN_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARS
